    "Langage inconnu : bloc avec son étiquette, sans coloration.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langage inconnu : bloc avec son étiquette, sans coloration."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown language: a block with its label, without highlighting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unbekannte Sprache: Block mit seiner Beschriftung, ohne Hervorhebung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lenguaje desconocido: bloque con su etiqueta, sin resaltado."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bahasa tidak dikenal: blok dengan labelnya, tanpa pewarnaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linguaggio sconosciuto: blocco con la sua etichetta, senza evidenziazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不明な言語：ハイライトなしで、ラベル付きのブロックとして表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "알 수 없는 언어: 구문 강조 없이 레이블이 있는 블록으로 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linguagem desconhecida: bloco com seu rótulo, sem destaque de sintaxe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linguagem desconhecida: bloco com a sua etiqueta, sem realce."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bilinmeyen dil: etiketiyle birlikte bir blok, renklendirme yok."
