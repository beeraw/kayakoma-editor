    "Recharger affiche la version du disque et abandonne vos modifications.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharger affiche la version du disque et abandonne vos modifications."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload shows the version on disk and discards your changes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Neuladen wird die Version auf dem Datenträger angezeigt und deine Änderungen werden verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al recargar se muestra la versión del disco y se descartan tus cambios."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memuat ulang akan menampilkan versi di disk dan membuang perubahan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ricaricando viene mostrata la versione sul disco e le tue modifiche vengono scartate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "再読み込みすると、ディスク上のバージョンが表示され、変更内容は破棄されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다시 로드하면 디스크에 있는 버전이 표시되고 변경 사항이 취소됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recarregar mostra a versão do disco e descarta suas alterações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ao recarregar, é apresentada a versão no disco e as suas alterações são descartadas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeniden yükleme, diskteki sürümü gösterir ve değişikliklerinizi atar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新载入将显示磁盘上的版本，并放弃你的更改。"
          }
        },
        "zh-Hant": {
