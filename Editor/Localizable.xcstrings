    "Un nom ne peut pas contenir « / », ni commencer par un point.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom ne peut pas contenir « / », ni commencer par un point."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name cannot contain “/” or start with a dot."
          }
        },
        "de": {
