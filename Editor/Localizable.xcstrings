    "Renommez l'un des deux avant de le déplacer. Rien n'a été modifié.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renommez l'un des deux avant de le déplacer. Rien n'a été modifié."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename one of them before moving it. Nothing was changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Benenne eines der beiden um, bevor du es verschiebst. Es wurde nichts geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Renombra uno de los dos antes de moverlo. No se ha modificado nada."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ubah nama salah satunya sebelum memindahkan. Tidak ada yang diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rinomina uno dei due prima di spostarlo. Non è stato modificato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "どちらかの名前を変更してから移動してください。何も変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "둘 중 하나의 이름을 변경한 다음 이동하십시오. 변경된 내용은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Renomeie um dos dois antes de movê-lo. Nada foi alterado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Renomeie um dos dois antes de o mover. Nada foi alterado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Taşımadan önce ikisinden birini yeniden adlandırın. Hiçbir şey değiştirilmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先重新命名其中一个再移动。未作任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
