    "Vos modifications seront perdues si vous ne les enregistrez pas.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications seront perdues si vous ne les enregistrez pas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes will be lost if you don't save them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Änderungen gehen verloren, wenn du sie nicht sicherst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tus cambios se perderán si no los guardas."
          }
        },
